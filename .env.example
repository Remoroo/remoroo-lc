# Copy to .env and fill in for your cell.  .env is gitignored.
#
# Nothing in this repo hardcodes a robot, a host or a path.  These are the
# values the rig-side scripts need, and they are the only place your
# environment appears.

# --- your cell -------------------------------------------------------------- #
# A cell file describing YOUR robot.  See CELL_SPEC.md, and generate a starting
# point with:  python scripts/cell_from_urdf.py <robot.urdf> --name my_robot -o <path>
REMOROO_LC_CELL=configs/rig/my_cell.yaml

# --- hardware --------------------------------------------------------------- #
# Controller IPs, comma separated, in the same order as the cell's models.
REMOROO_LC_HOSTS=10.0.0.11,10.0.0.12

# Where recordings are written and read from.
REMOROO_LC_RECORDINGS=recordings

# --- optional: remote benchmarking ------------------------------------------ #
# Edge box to benchmark the single-instance path on.
REMOROO_LC_EDGE_HOST=user@10.0.0.20
